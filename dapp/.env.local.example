# --- Agent Playground (real wallet) ------------------------------------------

# Merchant API serving the paid /api/weather and /api/market-data routes.
NEXT_PUBLIC_RESOURCE_SERVER_URL=https://api.x402.hathor.dev

# --- Headless wallet proxy (server-side only, never NEXT_PUBLIC) -------------
# The shared hathor-wallet-headless that holds the hUSDC treasury and all
# per-user demo addresses. Later this moves to a server: change only the URL.
HEADLESS_URL=http://localhost:8002
HEADLESS_WALLET_ID=x402

# hUSDC token uid on testnet
HUSDC_TOKEN_UID=001adcc82ba9722714c849cf607d30cd3cd9c7e95b0b3cb58e1eb476fa346980

# Each new visitor gets this much hUSDC (atomic units; 500 = 5.00 hUSDC)
FUND_AMOUNT_ATOMIC=500

# Wallet address 0 — holds ALL hUSDC. Funding txs filter inputs to it and
# return change to it.
TREASURY_ADDRESS=WUcVUnahHUuGqFD52rgaM5Ef1HMG4ycMYg
